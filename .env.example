# ---------- 基础（必填） ----------
# 使用 deploy/docker-compose.yml 部署时由 compose 注入，无需填写
DATABASE_URL=postgres://mimir:mimir@localhost:55432/mimir
# 对外访问地址，用于 OAuth 回调与 RSS 输出中的链接
MIMIR_PUBLIC_URL=http://localhost:3000
# 至少 32 个字符的随机串：openssl rand -base64 48
MIMIR_SECRET_KEY=
# all | api | worker
MIMIR_ROLE=all
MIMIR_PORT=3000
# zh-CN | en
MIMIR_DEFAULT_LOCALE=zh-CN
MIMIR_LOG_LEVEL=info
# 启动时自动执行数据库迁移（多实例启动时由 advisory lock 互斥）
MIMIR_AUTO_MIGRATE=true
# 生产环境托管的 web 构建目录（docker 镜像内已设置）
# MIMIR_WEB_DIST=./apps/web/dist

# ---------- 登录 ----------
# 逗号分隔：password（本地密码，适合试用）、feishu
MIMIR_AUTH_PROVIDERS=password
# 飞书 / Lark 自建应用凭据；回调地址配置为 <MIMIR_PUBLIC_URL>/api/auth/callback/feishu
MIMIR_FEISHU_APP_ID=
MIMIR_FEISHU_APP_SECRET=
# feishu（open.feishu.cn）| lark（open.larksuite.com）
MIMIR_FEISHU_DOMAIN=feishu

# ---------- 抓取 ----------
# RSSHub 实例，逗号分隔，按顺序回退；公共实例 rsshub.app 通常拒绝服务端调用，建议自建
MIMIR_RSSHUB_URLS=
# 出口代理（http://、https:// 或 socks5://），仅对 config.proxy=true 的源生效
MIMIR_FETCH_PROXY=
# 额外放行的网段。SSRF 防护默认只放行公网地址；本机使用 fake-IP 代理（Clash/Surge TUN）时
# DNS 会返回 198.18.0.0/15 与 2001:2::/48，需要在这里显式放行
MIMIR_FETCH_ALLOWED_CIDRS=
MIMIR_FETCH_CONCURRENCY=8
# 抓取请求的 User-Agent，留空使用默认值
# MIMIR_FETCH_USER_AGENT=

# ---------- 数据 ----------
# 正文保留天数，过期且无人星标的条目清空正文，元数据保留
MIMIR_CONTENT_RETENTION_DAYS=30

# ---------- docker compose 部署（deploy/docker-compose.yml）----------
# 对外域名，caddy 据此申请证书
# MIMIR_DOMAIN=mimir.example.com
# POSTGRES_PASSWORD=
